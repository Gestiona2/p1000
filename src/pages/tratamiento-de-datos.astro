---
import Layout from "../layouts/Layout.astro";
import legal from "../datos/legal.json";
import sitio from "../datos/sitio.json";
import { enlaceWhatsApp } from "../lib/formato.js";

const documento = legal.datos;
const fecha = new Date(`${legal.actualizado}T12:00:00`).toLocaleDateString("es-CO", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
const whatsapp = enlaceWhatsApp(sitio.whatsapp, "Hola P1000, quiero ejercer mis derechos sobre mis datos personales.");
---

<Layout titulo={`${documento.titulo} · P1000`} descripcion={`${documento.titulo} de P1000.`}>
  <div class="envoltura legal">
    <nav class="migas" aria-label="Ruta">
      <a href="/">Inicio</a>
      <span>/</span>
      <span>{documento.titulo}</span>
    </nav>

    <article class="legal-doc">
      <span class="eyebrow">Legal</span>
      <h1>{documento.titulo}</h1>
      <p class="legal-fecha">Última actualización: {fecha}</p>
      {documento.entrada && <p class="legal-entrada">{documento.entrada}</p>}

      {documento.secciones.map((seccion) => (
        <section>
          <h2>{seccion.titulo}</h2>
          <p>{seccion.texto}</p>
        </section>
      ))}

      <div class="legal-pie">
        <a class="btn btn-turquesa" href={whatsapp} target="_blank" rel="noopener">
          Escribir por WhatsApp
        </a>
        <a class="btn btn-borde" href="/privacidad">Ver política de privacidad</a>
      </div>
    </article>
  </div>
</Layout>
