---
import Layout from "../../layouts/Layout.astro";
import productos from "../../datos/productos.json";
import sitio from "../../datos/sitio.json";
import { precioTexto, precioCOP, oferta, enlaceWhatsApp, mensajeProducto } from "../../lib/formato.js";

export function getStaticPaths() {
  return productos.map((producto) => ({
    params: { slug: producto.slug },
    props: { producto },
  }));
}

const { producto } = Astro.props;
const relacionados = productos.filter(
  (p) => p.marca === producto.marca && p.slug !== producto.slug
);
const whatsapp = enlaceWhatsApp(sitio.whatsapp, mensajeProducto(producto));
const imagenes = producto.imagenes?.length ? producto.imagenes : ["/img/placeholder.svg"];
const titulo = `${producto.titulo} · P1000`;
const descripcion = `${producto.titulo}${producto.color ? ` en ${producto.color.toLowerCase()}` : ""}. ${producto.descripcion}`;
const tallas = producto.tallas?.length ? producto.tallas.join(" · ") : null;
const material = producto.material || null;
const promo = oferta(producto);
const colores = [...new Set([...(producto.colores || []), producto.color].filter(Boolean))];
const opcionesTalla = Array.isArray(producto.tallas) ? producto.tallas : [];
---

<Layout titulo={titulo} descripcion={descripcion} activa="calzado">
  <div class="envoltura producto">
    <nav class="migas" aria-label="Ruta">
      <a href="/">Inicio</a>
      <span>/</span>
      <a href="/calzado">Calzado</a>
      <span>/</span>
      <span>{producto.titulo}</span>
    </nav>

    <div class="producto-grid">
      <div>
        <div class="galeria-principal">
          <img
            id="imagenPrincipal"
            src={imagenes[0]}
            alt={`${producto.titulo}${producto.color ? `, ${producto.color}` : ""}`}
            width="1000"
            height="1000"
          />
        </div>

        {imagenes.length > 1 && (
          <div class="galeria-miniaturas" role="group" aria-label="Fotos del producto">
            {imagenes.map((src, i) => (
              <button
                type="button"
                class={`miniatura${i === 0 ? " activa" : ""}`}
                data-src={src}
                aria-label={`Ver foto ${i + 1} de ${imagenes.length}`}
                aria-pressed={i === 0 ? "true" : "false"}
              >
                <img src={src} alt="" loading="lazy" width="200" height="200" />
              </button>
            ))}
          </div>
        )}
      </div>

      <div class="info-producto">
        <span class="eyebrow">Calzado</span>
        {producto.marca && <p class="marca-producto">{producto.marca}</p>}
        <h1>{producto.titulo}</h1>
        {producto.color && <p class="info-color">Color: {producto.color}</p>}

        <div class="info-precio">
          <div class="info-precio-linea">
            {promo.descuento && <span class="ficha-descuento">-{promo.descuento}%</span>}
            <strong>{precioTexto(producto)}</strong>
            {promo.descuento && <s>{precioCOP(producto.precio_antes)}</s>}
          </div>
          <span>
            {promo.descuento
              ? `Ahorras ${precioCOP(promo.ahorro)}. Confirma tallas y disponibilidad por WhatsApp.`
              : "Confirma el valor final y la disponibilidad por WhatsApp."}
          </span>
        </div>

        <p class="info-descripcion">{producto.descripcion}</p>

        <dl class="ficha">
          <dt>Marca</dt>
          <dd>{producto.marca ?? "Por confirmar"}</dd>
          <dt>Color</dt>
          <dd>{producto.color ?? "Por confirmar"}</dd>
          <dt>Tallas</dt>
          <dd class={tallas ? "" : "pendiente"}>{tallas ?? "Por confirmar"}</dd>
          <dt>Material</dt>
          <dd class={material ? "" : "pendiente"}>{material ?? "Por confirmar"}</dd>
          <dt>Disponibilidad</dt>
          <dd>{producto.stock ? "Disponible para consulta" : "Agotado por ahora"}</dd>
        </dl>

        <div class="acciones-detalle">
          <div class="elegir-par" id="formParDetalle">
            <label>Talla de este par
              <select name="talla">
                {opcionesTalla.length > 0
                  ? opcionesTalla.map((talla) => <option value={talla}>{talla}</option>)
                  : <option value="Por confirmar">Por confirmar</option>}
              </select>
            </label>
            <label>Color de este par
              <select name="color">
                {colores.length > 0
                  ? colores.map((color) => <option value={color} selected={color === producto.color}>{color}</option>)
                  : <option value="">Por confirmar</option>}
              </select>
            </label>
          </div>
          <p class="nota-par">
            {opcionesTalla.length > 0
              ? "Elige la talla y el color de cada par. Si vas a pedir varios, agrégalos uno por uno."
              : "Todavía no tenemos las tallas cargadas: el pedido queda como “por confirmar” y se acuerda por WhatsApp."}
          </p>

          <button
            type="button"
            class="btn btn-azul"
            id="agregarDetalle"
            data-agregar={producto.slug}
            data-titulo={producto.titulo}
            data-color={producto.color || ""}
            data-colores={JSON.stringify(colores)}
            data-tallas={JSON.stringify(opcionesTalla)}
            data-imagen={imagenes[0].replace(/^\/+/, "")}
            data-form-par="formParDetalle"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.6L21 7H6" />
              <circle cx="10" cy="20" r="1.4" /><circle cx="18" cy="20" r="1.4" />
            </svg>
            Agregar par al pedido
          </button>

          <a href={whatsapp} class="btn btn-turquesa" target="_blank" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2a10 10 0 0 0-8.5 15.2L2 22l4.9-1.4A10 10 0 1 0 12 2zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-2.9.8.8-2.8-.2-.3A8 8 0 1 1 12 20zm4.4-5.8c-.2-.1-1.4-.7-1.6-.8s-.4-.1-.6.1-.6.8-.8 1-.3.2-.6.1a6.5 6.5 0 0 1-1.9-1.2 7.2 7.2 0 0 1-1.3-1.7c-.1-.2 0-.4.1-.5l.4-.5c.1-.2.2-.3.3-.5s0-.4 0-.5-.6-1.4-.8-1.9-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.5 4 5.3 5.3 0 0 0 3.3.6 2.8 2.8 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.2-.2-.4-.3z" />
            </svg>
            Consultar por WhatsApp
          </a>
          <a href="/calzado" class="btn btn-borde">Seguir mirando el catálogo</a>
          <p class="nota-detalle">
            Las fotos muestran el estilo y el color de la referencia. Confirma características,
            tallas y precio antes de comprar.
          </p>
        </div>
      </div>
    </div>
  </div>

  {relacionados.length > 0 && (
    <section class="variantes">
      <div class="envoltura">
        <h2>Otros colores de la línea {producto.marca}</h2>
        <p>Misma línea, distinto acabado. Toca una referencia para verla completa.</p>
        <div class="variantes-grid">
          {relacionados.map((p) => (
            <a href={`/calzado/${p.slug}`} class="variante" aria-label={`Ver ${p.titulo}`}>
              <img src={p.imagenes[0]} alt={p.titulo} loading="lazy" width="200" height="200" />
              <span>{p.color ?? p.titulo}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>

<script is:inline>
  (function () {
    var principal = document.getElementById("imagenPrincipal");
    var miniaturas = Array.prototype.slice.call(document.querySelectorAll(".miniatura"));
    if (!principal || !miniaturas.length) return;

    miniaturas.forEach(function (boton) {
      boton.addEventListener("click", function () {
        principal.src = boton.dataset.src;
        miniaturas.forEach(function (otra) {
          otra.classList.remove("activa");
          otra.setAttribute("aria-pressed", "false");
        });
        boton.classList.add("activa");
        boton.setAttribute("aria-pressed", "true");
      });
    });
  })();
</script>
