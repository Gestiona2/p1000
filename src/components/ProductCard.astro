---
import { precioTexto, precioCOP, oferta, enlaceWhatsApp, mensajeProducto } from "../lib/formato.js";
import sitio from "../datos/sitio.json";

interface Props {
  producto: {
    slug: string;
    titulo: string;
    precio: number | null;
    precio_antes?: number | null;
    marca?: string | null;
    color?: string | null;
    colores?: string[];
    tallas?: string[];
    stock: boolean;
    destacado?: boolean;
    imagenes: string[];
    descripcion?: string;
  };
}

const { producto } = Astro.props;
const imagen = producto.imagenes?.[0] || "/img/placeholder.svg";
const enlace = enlaceWhatsApp(sitio.whatsapp, mensajeProducto(producto));
const url = `/calzado/${producto.slug}`;
const promo = oferta(producto);
const colores = [...new Set([...(producto.colores || []), producto.color].filter(Boolean))];
const tallas = Array.isArray(producto.tallas) ? producto.tallas : [];
const buscar = [producto.titulo, producto.marca, producto.color, producto.descripcion, ...(producto.tallas || [])]
  .filter(Boolean)
  .join(" ")
  .toLowerCase();
---

<article class="tarjeta-producto" data-producto data-buscar={buscar}>
  <a href={url} class="foto" aria-label={`Ver detalles de ${producto.titulo}`}>
    <img src={imagen} alt={`${producto.titulo}${producto.color ? `, ${producto.color}` : ""}`} loading="lazy" width="600" height="600" />
    {!producto.stock && <span class="badge-agotado">Agotado</span>}
    {promo.descuento && producto.stock && <span class="badge-descuento">-{promo.descuento}%</span>}
    {producto.destacado && producto.stock && <span class="badge-destacado">Destacado</span>}
  </a>
  <div class="cuerpo">
    {producto.marca && <span class="marca-producto">{producto.marca}</span>}
    <h3><a href={url}>{producto.titulo}</a></h3>
    {producto.color && <p class="color-producto">{producto.color}</p>}
    {promo.descuento ? (
      <p class="precio precio-oferta">
        <s>{precioCOP(producto.precio_antes)}</s>
        <strong>{precioTexto(producto)}</strong>
        <span class="precio-ahorro">Ahorras {precioCOP(promo.ahorro)}</span>
      </p>
    ) : (
      <p class="precio">{precioTexto(producto)}</p>
    )}
    <div class="acciones-producto">
      <a href={url} class="btn btn-azul">Ver detalles</a>
      <button
        type="button"
        class="btn btn-borde btn-icono"
        data-agregar={producto.slug}
        data-titulo={producto.titulo}
        data-color={producto.color || ""}
        data-colores={JSON.stringify(colores)}
        data-tallas={JSON.stringify(tallas)}
        data-imagen={imagen.replace(/^\/+/, "")}
        aria-label={`Agregar ${producto.titulo} al pedido`}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.6L21 7H6" />
          <circle cx="10" cy="20" r="1.4" /><circle cx="18" cy="20" r="1.4" />
        </svg>
      </button>
      <a href={enlace} class="btn btn-borde btn-icono" target="_blank" rel="noopener" aria-label={`Consultar ${producto.titulo} por WhatsApp`}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2a10 10 0 0 0-8.5 15.2L2 22l4.9-1.4A10 10 0 1 0 12 2zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-2.9.8.8-2.8-.2-.3A8 8 0 1 1 12 20zm4.4-5.8c-.2-.1-1.4-.7-1.6-.8s-.4-.1-.6.1-.6.8-.8 1-.3.2-.6.1a6.5 6.5 0 0 1-1.9-1.2 7.2 7.2 0 0 1-1.3-1.7c-.1-.2 0-.4.1-.5l.4-.5c.1-.2.2-.3.3-.5s0-.4 0-.5-.6-1.4-.8-1.9-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.5 4 5.3 5.3 0 0 0 3.3.6 2.8 2.8 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.2-.2-.4-.3z" />
        </svg>
      </a>
    </div>
  </div>
</article>
